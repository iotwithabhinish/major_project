# Copy this file to .env.local and enter the values for your authenticated MQTT broker.
# Leave VITE_MQTT_URL unset to use the built-in dashboard simulation.
VITE_MQTT_URL=wss://mqtt.example.com:8084/mqtt
VITE_MQTT_USERNAME=replace-me
VITE_MQTT_PASSWORD=replace-me
VITE_MQTT_ROOM_PREFIX=smart-home
# Solar forecast location and panel rating used by the weather + local-data prediction model.
# Place name shown on the weather widget (the weather uses VITE_SOLAR_LAT/LON).
VITE_LOCATION_NAME=Bengaluru
VITE_SOLAR_LAT=12.9716
VITE_SOLAR_LON=77.5946
VITE_SOLAR_RATED_WATTS=1
# Panel orientation: tilt from horizontal (deg) and direction (0 = south, -90 = east, 90 = west, 180 = north).
VITE_SOLAR_TILT=13
VITE_SOLAR_AZIMUTH=0
# Power temperature coefficient (%/degC) and highest open-circuit voltage the panel can give.
VITE_SOLAR_TEMP_COEFF=-0.4
VITE_SOLAR_MAX_VOLTS=8
